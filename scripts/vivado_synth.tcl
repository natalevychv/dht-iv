# -----------------------------------------------------------------------------
# vivado_synth.tcl
#
# Out-of-context synthesis and implementation of the naive and proposed
# DHT-IV modules for resource and timing comparison (Vivado non-project
# batch mode).
#
# For every selected N and architecture the script synthesizes the top
# module (nN_naive / nN_prop_top) with -mode out_of_context, runs
# opt/place/route and writes to build/vivado/<top>/:
#     <top>_wrap.vhd      - generated register wrapper (see below)
#     utilization.rpt     - report_utilization of the whole design
#     timing_summary.rpt  - report_timing_summary
#     critical_path.rpt   - report_timing of the worst setup path
#     fanout.rpt          - report_high_fanout_nets (10 nets with the highest fanout)
#
# Register wrapper (default): the module is instantiated as u_dut in a
# generated wrapper <top>_wrap that registers all inputs (rst, valid_in, x)
# and outputs (valid_out, y). Every timed path then starts and ends at a
# register, as in a real system, so the architectures are compared under
# the same conditions (without the wrapper a module whose first logic is
# fed directly from the input ports gains ~2 ns, since an input port has
# no clock-to-Q and no source clock delay). The resources in the summary
# (LUT, FF, DSP, CARRY4) are counted for u_dut only, without the wrapper
# registers. Registers absorbed into DSP blocks (AREG/BREG/MREG/PREG) are
# not counted as FF. With --no-wrap the module is synthesized directly as
# the top (the behaviour of earlier runs).
#
# A summary of all runs is printed and written to build/vivado/summary.csv:
#     top, N, arch, LUT, FF, DSP, CARRY4, WNS [ns], period [ns], fmax [MHz]
#
# fmax = 1000 / (period - WNS) is the estimated maximum clock frequency.
# Inputs and outputs are constrained with zero delay to clk. Hold is not
# checked on the ports, since it depends on the surrounding design. Use the
# same period for all designs: the achieved fmax depends on how hard the
# target is.
#
# Usage (Vivado Tcl Shell):
#   vivado -mode batch -nojournal -nolog -source scripts/vivado_synth.tcl
#   vivado -mode batch -nojournal -nolog -source scripts/vivado_synth.tcl \
#          -tclargs 6 8 --arch proposed --period 15
#
# Options:
#   N ...             selected N (default: 3..8)
#   --arch A          naive, proposed or both (default: both)
#   --period P        clock period in ns (default: 20)
#   --part PART       FPGA part (default: xc7a200tsbg484-1)
#   --no-wrap         synthesize the module without the register wrapper
# -----------------------------------------------------------------------------

set REPO_ROOT [file dirname [file dirname [file normalize [info script]]]]
set OUT_DIR   [file join $REPO_ROOT build vivado]

set ns     {}
set arch   both
set period 20.0
set part   xc7a200tsbg484-1
set wrap   1

if {[info exists ::argv]} {
    for {set i 0} {$i < [llength $::argv]} {incr i} {
        set a [lindex $::argv $i]
        switch -- $a {
            --arch    { set arch   [lindex $::argv [incr i]] }
            --period  { set period [lindex $::argv [incr i]] }
            --part    { set part   [lindex $::argv [incr i]] }
            --no-wrap { set wrap   0 }
            default   { lappend ns $a }
        }
    }
}
if {[llength $ns] == 0} {
    set ns {3 4 5 6 7 8}
}
switch -- $arch {
    both     { set archs {naive proposed} }
    naive    { set archs {naive} }
    proposed { set archs {proposed} }
    default  { error "Unknown --arch $arch (naive, proposed or both)" }
}


# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------

# VHDL files and top entity of one design.
proc design_sources {n arch} {
    global REPO_ROOT
    set files [glob [file join $REPO_ROOT src common *.vhd]]
    if {$arch eq "naive"} {
        lappend files [file join $REPO_ROOT src naive n$n n${n}_naive.vhd]
        return [list n${n}_naive $files]
    }
    set files [concat $files [glob [file join $REPO_ROOT src proposed n$n *.vhd]]]
    return [list n${n}_prop_top $files]
}

# Register wrapper <top>_wrap around the module <top> with N inputs/outputs.
proc write_wrapper {path top n} {
    set f [open $path w]
    puts $f [string map [list @TOP@ $top @HIGH@ [expr {$n - 1}]] {-------------------------------------------------------------------------------
-- @TOP@_wrap.vhd - generated by scripts/vivado_synth.tcl, do not edit
--
-- Synthesis wrapper: registers all inputs and outputs of @TOP@, so that
-- every timed path starts and ends at a register.
-------------------------------------------------------------------------------
library ieee;
use ieee.std_logic_1164.all;
use ieee.fixed_pkg.all;
use work.fixed_types_pkg.all;

entity @TOP@_wrap is
    port (
        clk       : in  std_logic;
        rst       : in  std_logic;
        valid_in  : in  std_logic;
        x         : in  sfix32_vector(0 to @HIGH@);
        valid_out : out std_logic;
        y         : out sfix32_vector(0 to @HIGH@)
    );
end entity @TOP@_wrap;

architecture rtl of @TOP@_wrap is
    signal rst_r, valid_in_r, valid_out_d : std_logic;
    signal x_r, y_d                       : sfix32_vector(0 to @HIGH@);
begin

    process (clk)
    begin
        if rising_edge(clk) then
            rst_r      <= rst;
            valid_in_r <= valid_in;
            x_r        <= x;
            valid_out  <= valid_out_d;
            y          <= y_d;
        end if;
    end process;

    u_dut : entity work.@TOP@
        port map (
            clk       => clk,
            rst       => rst_r,
            valid_in  => valid_in_r,
            x         => x_r,
            valid_out => valid_out_d,
            y         => y_d
        );

end architecture rtl;}]
    close $f
}

# Out-of-context timing constraints for the given clock period.
proc write_xdc {path period} {
    set f [open $path w]
    puts $f "create_clock -period $period -name clk \[get_ports clk\]"
    puts $f "set_property HD.CLK_SRC BUFGCTRL_X0Y0 \[get_ports clk\]"
    puts $f "set_input_delay  0 -clock clk \[get_ports -filter {DIRECTION == IN && NAME != clk}\]"
    puts $f "set_output_delay 0 -clock clk \[get_ports -filter {DIRECTION == OUT}\]"
    # Hold on the ports depends on the surrounding design, not on the module.
    puts $f "set_false_path -hold -from \[get_ports -filter {DIRECTION == IN && NAME != clk}\]"
    puts $f "set_false_path -hold -to   \[get_ports -filter {DIRECTION == OUT}\]"
    close $f
}

# Value of the "Used" column of a report_utilization row.
proc util_value {report name} {
    if {[regexp "\\|\\s*${name}\\*?\\s*\\|\\s*(\\d+)" $report -> v]} {
        return $v
    }
    return -1
}


# -----------------------------------------------------------------------------
# Runs
# -----------------------------------------------------------------------------

file mkdir $OUT_DIR
set xdc [file join $OUT_DIR timing.xdc]
write_xdc $xdc $period

set rows {}
foreach n $ns {
    foreach a $archs {
        lassign [design_sources $n $a] top files
        set dir [file join $OUT_DIR $top]
        file mkdir $dir
        set synth_top $top
        if {$wrap} {
            set synth_top ${top}_wrap
            set wrapper [file join $dir ${synth_top}.vhd]
            write_wrapper $wrapper $top $n
            lappend files $wrapper
        }
        puts "================================="
        puts " $synth_top (period $period ns, $part)"
        puts "================================="

        create_project -in_memory -part $part
        read_vhdl -vhdl2008 $files
        read_xdc $xdc
        synth_design -top $synth_top -part $part -mode out_of_context
        opt_design
        place_design
        route_design

        report_utilization    -file [file join $dir utilization.rpt]
        report_timing_summary -file [file join $dir timing_summary.rpt]
        report_timing -max_paths 1 -setup -file [file join $dir critical_path.rpt]
        report_high_fanout_nets -max_nets 10 -file [file join $dir fanout.rpt]

        # Resources of the module only (without the wrapper registers).
        if {$wrap} {
            set dut [get_cells -quiet u_dut]
            if {[llength $dut] == 0} {
                puts "WARNING: instance u_dut not found, resources of the whole design reported"
                set util  [report_utilization -return_string]
                set carry [llength [get_cells -hier -quiet -filter {REF_NAME == CARRY4}]]
            } else {
                set util  [report_utilization -cells $dut -return_string]
                set carry [llength [get_cells -hier -quiet -filter {REF_NAME == CARRY4 && NAME =~ u_dut/*}]]
            }
        } else {
            set util  [report_utilization -return_string]
            set carry [llength [get_cells -hier -quiet -filter {REF_NAME == CARRY4}]]
        }
        set lut  [util_value $util "Slice LUTs"]
        set ff   [util_value $util "Slice Registers"]
        set dsp  [util_value $util "DSPs"]
        set wns  [get_property SLACK [get_timing_paths -setup -max_paths 1]]
        set fmax [format %.1f [expr {1000.0 / ($period - $wns)}]]

        lappend rows [list $top $n $a $lut $ff $dsp $carry $wns $period $fmax]
        close_project
    }
}


# -----------------------------------------------------------------------------
# Summary
# -----------------------------------------------------------------------------

set header {top N arch LUT FF DSP CARRY4 WNS_ns period_ns fmax_MHz}
set csv [open [file join $OUT_DIR summary.csv] w]
puts $csv [join $header ,]
foreach r $rows {
    puts $csv [join $r ,]
}
close $csv

set fmt "%-14s %2s %-9s %7s %7s %5s %7s %9s %10s %9s"
puts ""
puts [format $fmt {*}$header]
foreach r $rows {
    puts [format $fmt {*}$r]
}
puts ""
if {$wrap} {
    puts "Register wrapper: on (resources of u_dut only)"
} else {
    puts "Register wrapper: off"
}
puts "Summary written to [file join $OUT_DIR summary.csv]"
